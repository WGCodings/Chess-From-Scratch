{
  "name": "@cfs/codegen",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only AND MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "embed": "node scripts/embed.mjs",
    "prebuild": "node scripts/embed.mjs",
    "build": "tsc -p tsconfig.json --noEmit",
    "pretypecheck": "node scripts/embed.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/embed.mjs",
    "test": "vitest run",
    "gen:reference": "node scripts/embed.mjs && tsx scripts/write-reference.ts",
    "check:generated": "node scripts/embed.mjs && tsx scripts/check-generated.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
