{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess From Scratch",
  "version": "0.1.0",
  "identifier": "com.wgcodings.chessfromscratch",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "npm run dev -w @cfs/web",
    "beforeBuildCommand": "npm run build -w @cfs/web"
  },
  "app": {
    "windows": [
      {
        "title": "Chess From Scratch",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Build, run and test chess engines with blocks",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
